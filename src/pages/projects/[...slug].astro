---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../utils/site";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={`${project.data.title} — Chaitanya V.`} description={project.data.summary}>
  <div class="container">
    <section class="detail-hero">
      <div><a class="text-link" href={withBase("projects/")}>← All projects</a><div style="margin-top:28px" class="eyebrow">{project.data.category} · {project.data.status==="developing"?"IN DEVELOPMENT":"PROJECT CASE STUDY"}</div><h1>{project.data.title}</h1><p class="lead">{project.data.subtitle}</p><p class="body-copy">{project.data.summary}</p><div class="tag-list">{project.data.tags.map(t=><span class="tag">{t}</span>)}</div></div>
      <div class="detail-art"><svg viewBox="0 0 500 280" role="img" aria-label="Abstract project workflow"><rect x="20" y="75" width="105" height="130" rx="4" fill="#fffefa" stroke="#c9d0d0"/><path d="M40 105h65M40 125h65M40 145h48" stroke="#315fd4" stroke-width="5"/><path d="M140 140h55m-12-10 12 10-12 10" fill="none" stroke="#66717b" stroke-width="2"/><circle cx="250" cy="140" r="54" fill="#e5ebfb"/><path d="M250 105v70m-35-35h70" stroke="#315fd4" stroke-width="4"/><path d="M310 140h55m-12-10 12 10-12 10" fill="none" stroke="#66717b" stroke-width="2"/><rect x="380" y="75" width="100" height="130" rx="4" fill="#e6ece3" stroke="#b9c8b4"/><path d="m400 140 20 20 40-45" fill="none" stroke="#58705c" stroke-width="5"/></svg></div>
    </section>
    <section class="detail-layout">
      <nav class="detail-nav" aria-label="Project sections"><a href="#overview">Overview</a><a href="#problem">Problem</a><a href="#approach">Approach</a><a href="#implementation">Implementation</a><a href="#results">Results</a><a href="#learnings">Learnings</a></nav>
      <article class="detail-body"><Content /></article>
    </section>
  </div>
</BaseLayout>

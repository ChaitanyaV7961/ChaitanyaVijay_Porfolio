---
import "../styles/global.css";
import { withBase, site } from "../utils/site";
const { title = "Chaitanya V. — Business | Data | AI | Technology", description = "Portfolio of Chaitanya V." } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase("")}>
        <strong>{site.name}</strong><span class="brand-divider">—</span><span class="brand-descriptor">{site.descriptor}</span>
      </a>
      <button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">Menu <span>＋</span></button>
      <nav class="main-nav" aria-label="Main navigation">
        <a class:list={[path === "" || path === "index.html" ? "active" : ""]} href={withBase("")}>Home</a>
        <a class:list={[path.startsWith("about") ? "active" : ""]} href={withBase("about/")}>About</a>
        <a class:list={[path.startsWith("projects") ? "active" : ""]} href={withBase("projects/")}>Projects</a>
        <a class:list={[path.startsWith("research") ? "active" : ""]} href={withBase("research/")}>Research & Writing</a>
        <a class:list={[path.startsWith("contact") ? "active" : ""]} href={withBase("contact/")}>Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div><span class="eyebrow">LET'S CONNECT</span><h2>Have something interesting in mind?</h2></div>
      <a class="text-link" href={withBase("contact/")}>Get in touch <span>↗</span></a>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Chaitanya V.</span><span>Business · Data · AI · Technology</span><a href={withBase("")}>Back to top ↑</a></div>
    </footer>
    <script>
      const toggle = document.querySelector(".menu-toggle");
      const nav = document.querySelector(".main-nav");
      toggle?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open") ?? false;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.querySelector("span").textContent = open ? "−" : "＋";
      });
    </script>
  </body>
</html>
